ALGORITHIM=JWT_ALGORITHIM
EXPIRE_TIME=JWT_EXPIRE
SECRET_KEY=JWT_KEY

# Gemini AI Settings
API_KEY=AIza...
GEMINI_API_KEYS=key1,key2,key3
MODEL=gemini-2.5-flash
MAX_CONCURRENT_GEMINI_REQUESTS=5

# Redis Caching & Rate Limiting
REDIS_URL=redis://localhost:6379/0
AI_CACHE_TTL=86400
API_KEY_CACHE_TTL=300

# Cloudinary CDN
CLOUDINARY_URL=CLOUDINARY_KEY

# PostgreSQL Database
POSTGRES_CONNECTION_STRING=POSTGRES_DB_CONN_STRING
